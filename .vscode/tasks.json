{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build program",
      "detail": "Builds dist\\WineInventoryManager\\WineInventoryManager.exe (Ctrl+Shift+B)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Run program",
      "detail": "Starts the built program",
      "type": "shell",
      "command": "${workspaceFolder}\\dist\\WineInventoryManager\\WineInventoryManager.exe",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Build and run program",
      "type": "shell",
      "command": "echo Built and started",
      "dependsOn": ["Build program", "Run program"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
